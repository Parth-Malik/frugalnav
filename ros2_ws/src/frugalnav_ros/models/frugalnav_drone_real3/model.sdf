<?xml version="1.0" ?>
<!-- Demo 3 drone: downward camera (ArUco fixes + optical-flow odometry), a forward
     camera for the operator view, and a 360 deg laser on /frugalnav/scan for obstacle
     detection. The downward camera matches frugalnav_drone_cam. -->
<sdf version="1.6">
  <model name="frugalnav_drone">
    <link name="base_link">
      <gravity>0</gravity>
      <inertial><mass>1.0</mass>
        <inertia><ixx>0.02</ixx><iyy>0.02</iyy><izz>0.03</izz><ixy>0</ixy><ixz>0</ixz><iyz>0</iyz></inertia></inertial>
      <collision name="c"><geometry><box><size>0.5 0.5 0.15</size></box></geometry></collision>
      <visual name="body"><geometry><box><size>0.5 0.5 0.15</size></box></geometry>
        <material><ambient>0.22 0.74 0.97 1</ambient><diffuse>0.22 0.74 0.97 1</diffuse><emissive>0.05 0.2 0.3 1</emissive></material></visual>

      <!-- downward camera: optical +X points straight down (pitch +90 deg) -->
      <sensor name="down_cam" type="camera">
        <pose>0 0 -0.12 0 1.5708 0</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.5</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>80</far></clip>
          <!-- real lens: mild barrel distortion + sensor noise. camera_info carries the
               coefficients, and perception passes them to solvePnP, so this is the exact
               path a real camera takes (undistort before pose). -->
          <distortion><k1>-0.08</k1><k2>0.02</k2><k3>0.0</k3><p1>0.0</p1><p2>0.0</p2><center>0.5 0.5</center></distortion>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.005</stddev></noise>
        </camera>
        <plugin name="down_cam_plugin" filename="libgazebo_ros_camera.so">
          <ros><namespace>/frugalnav</namespace></ros>
          <camera_name>down_cam</camera_name>
          <frame_name>down_cam_link</frame_name>
        </plugin>
      </sensor>

      <!-- forward/approach camera: faces -X (the direction of travel toward the target) -->
      <sensor name="front_cam" type="camera">
        <pose>0.15 0 0 0 0 3.14159</pose>
        <always_on>1</always_on>
        <update_rate>15</update_rate>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>1.4</horizontal_fov>
          <image><width>640</width><height>480</height><format>R8G8B8</format></image>
          <clip><near>0.1</near><far>90</far></clip>
        </camera>
        <plugin name="front_cam_plugin" filename="libgazebo_ros_camera.so">
          <ros><namespace>/frugalnav</namespace></ros>
          <camera_name>front_cam</camera_name>
          <frame_name>front_cam_link</frame_name>
        </plugin>
      </sensor>

      <!-- cheap 360 deg laser rangefinder: obstacle detection = min range in the arc.
           Mounted 0.2 m above the body so the horizontal scan plane clears the drone
           itself (else it would range its own frame at the minimum distance). -->
      <sensor name="scanner" type="ray">
        <pose>0 0 0.2 0 0 0</pose>
        <always_on>1</always_on>
        <update_rate>20</update_rate>
        <visualize>false</visualize>
        <ray>
          <scan><horizontal>
            <samples>180</samples><resolution>1</resolution>
            <min_angle>-3.14159</min_angle><max_angle>3.14159</max_angle>
          </horizontal></scan>
          <range><min>0.3</min><max>8.0</max><resolution>0.02</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.02</stddev></noise>
        </ray>
        <plugin name="scan_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros><namespace>/frugalnav</namespace><remapping>~/out:=scan</remapping></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>base_link</frame_name>
        </plugin>
      </sensor>

      <!-- IMU: gyro + accel at 200 Hz. The gyro de-rotates the optical flow (a real
           drone tilts to move, which swings the camera; without this the flow reads
           that tilt as translation). Also feeds the scheduler's inertial cue. -->
      <sensor name="imu" type="imu">
        <always_on>1</always_on>
        <update_rate>200</update_rate>
        <imu>
          <angular_velocity><x><noise type="gaussian"><stddev>0.003</stddev></noise></x>
            <y><noise type="gaussian"><stddev>0.003</stddev></noise></y>
            <z><noise type="gaussian"><stddev>0.003</stddev></noise></z></angular_velocity>
        </imu>
        <plugin name="imu_plugin" filename="libgazebo_ros_imu_sensor.so">
          <ros><namespace>/frugalnav</namespace><remapping>~/out:=imu</remapping></ros>
          <frame_name>base_link</frame_name>
        </plugin>
      </sensor>

      <!-- downward single-beam rangefinder = the altimeter. Optical flow needs a metric
           scale (v = flow * altitude / focal); this supplies the altitude for real. -->
      <sensor name="altimeter" type="ray">
        <pose>0 0 -0.12 0 1.5708 0</pose>
        <always_on>1</always_on>
        <update_rate>30</update_rate>
        <ray>
          <scan><horizontal><samples>1</samples><resolution>1</resolution>
            <min_angle>0</min_angle><max_angle>0</max_angle></horizontal></scan>
          <range><min>0.1</min><max>40.0</max><resolution>0.01</resolution></range>
          <noise><type>gaussian</type><mean>0.0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="alt_plugin" filename="libgazebo_ros_ray_sensor.so">
          <ros><namespace>/frugalnav</namespace><remapping>~/out:=height</remapping></ros>
          <output_type>sensor_msgs/Range</output_type>
          <frame_name>base_link</frame_name>
        </plugin>
      </sensor>
    </link>

    <plugin name="planar_move" filename="libgazebo_ros_planar_move.so">
      <ros><namespace>/frugalnav</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping><remapping>odom:=odom_planar</remapping></ros>
      <update_rate>50</update_rate><publish_rate>50</publish_rate>
      <publish_odom>true</publish_odom><publish_odom_tf>false</publish_odom_tf>
      <odometry_frame>world</odometry_frame><robot_base_frame>base_link</robot_base_frame>
      <covariance_x>0.0</covariance_x><covariance_y>0.0</covariance_y><covariance_yaw>0.0</covariance_yaw>
    </plugin>
    <plugin name="p3d" filename="libgazebo_ros_p3d.so">
      <ros><namespace>/frugalnav</namespace><remapping>odom:=truth</remapping></ros>
      <body_name>base_link</body_name><frame_name>world</frame_name>
      <update_rate>50</update_rate><gaussian_noise>0.0</gaussian_noise>
    </plugin>
  </model>
</sdf>
